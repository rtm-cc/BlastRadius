# Python
__pycache__/
*.pyc
.venv/
.cache/

# Generated by build-site / run; CI builds it fresh for Pages.
/public/

# Local credentials.
.env
.env.*
!.env.example

# The old app's backup holds a FreshRSS token; the import has already turned
# it into archive/. Same for an OPML export.
/backup*.json
*.opml
*.opml.xml

# Local tool/editor state.
.tmp
.tmp/
.DS_Store

# Windows download markers, left by copying files in from Explorer.
*:Zone.Identifier
