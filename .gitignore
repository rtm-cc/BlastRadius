# Python
__pycache__/
*.pyc
.venv/
.cache/

# Generated by build-site / run; CI builds it fresh for Pages.
/public/

# Local credentials.
.env
.env.*
!.env.example

# Feed lists exported from a reader (OPML) can carry private feed URLs.
*.opml
*.opml.xml

# Local tool/editor state.
.tmp
.tmp/
.DS_Store

# Windows download markers, left by copying files in from Explorer.
*:Zone.Identifier
